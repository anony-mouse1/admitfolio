# Secrets — never commit (any .env variant, incl. .env.production)
.env*

# Keep the template
!.env.example

# Local dev-preview pages — never publish (they'd go live on the prod domain).
# Mock-ups keep landing here one file at a time and each one had to be added by
# hand, so anything ending -mockup.html is ignored up front.
public/iphone-preview.html
public/iphone-preview.jpg
public/design-concepts.html
public/*-mockup.html
public/*-mock-up.html
public/**/*-mockup.html
public/**/*-mock-up.html

# Dependencies / noise
node_modules/
*.log
.DS_Store

# Seller submission data & uploaded essays — contains PII, never commit
listings.json
waitlist.json
essays/

# Local tooling & throwaway
.claude/
.codex/
index-indigo.html

# Next.js
/.next/
/out/
next-env.d.ts
.vercel

# Prisma / SQLite
*.db
*.db-journal
prisma/dev.db
prisma/migrations/dev.db
*.tsbuildinfo
public/browse-mockup.html
public/.mock-listings.json
