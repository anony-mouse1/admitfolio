// Admitfolio database schema.
//
// Runs on Supabase Postgres. DATABASE_URL is the pooled (Supavisor, port 6543)
// connection string with ?pgbouncer=true&connection_limit=1 for serverless;
// DIRECT_URL is the direct (port 5432) string used by prisma migrate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A verified seller — identity is a .edu email, proven via the OTP flow.
model Seller {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String? // scrypt "salt:hash", set at signup
  failedLogins   Int       @default(0) // consecutive bad passwords; reset on success
  lockedUntil    DateTime? // brute-force lockout expiry
  name           String? // full name; display follows the listing's anonymity choice
  paypalEmail    String? // where biweekly payouts go once buying launches
  bio            String? // short "about me" shown on the seller profile
  photoPath      String? // Supabase Storage path for the profile photo
  backgroundTags String    @default("[]") // JSON array of profile tags (e.g. First-generation)
  createdAt      DateTime  @default(now())
  listings       Listing[]
  admitProofs    AdmitProof[]
}

// An acceptance letter backing one school a seller claims in `Listing.admitTags`.
//
// Keyed on the SELLER, not the listing: a seller reuses the same admits across
// listings, and re-uploading the same letter each time would be busywork. The
// `schoolKey` is a normalised form (see lib/admitProof.ts) so "Tufts" and
// "Tufts University" are one proof rather than two.
//
// `pending` is the only status a seller can create. Only the admin console
// moves a proof to `verified` or `rejected`, and only a `verified` proof lets
// the public catalogue describe that admit as confirmed.
model AdmitProof {
  id          String    @id @default(cuid())
  seller      Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId    String
  schoolKey   String // normalised; collapses spellings of the same school
  schoolLabel String // what the seller actually typed, for display
  pdfPath     String? // Supabase Storage path, null until the upload lands
  status      String    @default("pending") // pending | verified | rejected
  adminNote   String? // why it was rejected, shown to the seller
  createdAt   DateTime  @default(now())
  reviewedAt  DateTime?
  // What the review panel made of the letter. Advisory only: the panel never
  // sets `status`, exactly as it never publishes a listing. It puts a note
  // beside the Verify button so a human decides with the reading already done.
  aiCheckedAt DateTime?
  aiGenuine   Boolean? // panel's read: does this look like a real admission decision
  aiNote      String? // one sentence - what it shows, or what is wrong with it

  @@unique([sellerId, schoolKey])
  @@index([status])
}

// One submission = one seller's package of essays for a school.
model Listing {
  id           String     @id @default(cuid())
  seller       Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId     String
  school       String
  gradYear     String?
  major        String? // the seller's current major at their university
  appliedMajors String? // major(s) they applied to with these essays, free text
  admitTags    String     @default("[]") // JSON array of schools they got into
  // anonymous | revealOnPurchase | full. See lib/anonymity.ts: the middle value
  // is a TIMING choice (nothing public, first name once bought), not a "show
  // less of the name" choice. Rows written before 2026-08 spell it 'firstName'
  // and are read as the same thing.
  anonymity    String     @default("anonymous")
  pricingMode  String     @default("package") // package | separate
  packagePrice Int? // whole dollars, when pricingMode = package
  teaser       String? // optional one-line hook shown on the public browse card
  // The opening sentence of the seller's own essay, read out of their uploaded
  // PDF. Only used when the seller left `teaser` empty, which is 68 of 144
  // approved listings, so those cards had nothing to say. Nullable forever:
  // short-answer listings have no narrative opening, and some PDFs are scans
  // with no text layer. Backfilled by scripts/extract-opening-lines.mjs.
  openingLine  String?
  status       String     @default("pending") // pending | approved | rejected | removed (seller take-down)
  adminNote    String?
  sellerNote   String? // optional note from the seller, shown to the admin during review
  createdAt    DateTime   @default(now())
  reviewedAt   DateTime?
  // Automated review (Claude reviewer panel). aiReviewedAt doubles as the
  // "already screened" guard for the cron query. Auto-approve flips `status`;
  // a flagged listing stays `pending` with these fields populated for the admin.
  aiReviewedAt DateTime? // set once the panel has run
  aiDecision   String? // approved | flagged
  aiConfidence String? // high | medium | low (lowest across the panel's lenses)
  aiReasons    String? // panel's concerns, shown to the admin on flagged listings
  aiSuggestion String? // approve | reject — pre-fills the flagged listing's action
  aiLenses     String? // JSON array of per-lens verdicts, so the admin can read the full review
  // Set only when a human admin decides from the console - never by the cron.
  // This is what separates "the panel cleared it" from "I looked at it myself",
  // and drives the unaudited counts on the review tabs.
  humanReviewedAt DateTime?
  // Admin shelf. Set from the console when a listing needs more thought than the
  // current pass allows. It carries no meaning to the seller and never changes
  // `status` - a shelved listing is exactly as published (or not) as before.
  savedAt      DateTime?
  essays       Essay[]
  purchases    Purchase[]

  @@index([status])
  @@index([sellerId])
}

// An individual essay within a listing.
model Essay {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  prompt    String // e.g. "Common App", "Why Yale"
  question  String? // custom prompt text when prompt = "Other"
  price     Int? // whole dollars, when the listing sells essays separately
  wordCount Int?
  pdfPath   String? // Supabase Storage object path, e.g. listings/<listingId>/<essayId>.pdf
  sortOrder Int      @default(0) // position in the seller's submitted list
  createdAt DateTime @default(now())

  @@index([listingId])
}

// Email captured from the "notify me at launch" forms.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A buyer checkout (payment integration is stubbed for now). listingId is
// optional so demo/sample-catalog purchases are still recorded; itemLabel keeps
// a human-readable description regardless.
model Purchase {
  id              String   @id @default(cuid())
  buyerEmail      String
  listing         Listing? @relation(fields: [listingId], references: [id])
  listingId       String?
  essayId         String? // null when the whole package was bought
  itemLabel       String? // e.g. "Stanford — Common App"
  amount          Int // whole dollars charged
  stripeSessionId String?  @unique // idempotency key for Stripe webhook retries
  // Buyer's IP at checkout. Captured in /api/checkout (which the buyer's
  // browser calls) and carried through Stripe session metadata - reading
  // x-forwarded-for in the webhook would record Stripe's servers instead.
  buyerIp         String?
  createdAt       DateTime @default(now())
  views           EssayView[]

  @@index([listingId])
}

// One row per essay read. Buyers have no account, so a view is attributed via
// the purchase (which carries Stripe's verified buyerEmail) rather than a user
// id. This is what makes a leaked watermark traceable to a person.
model EssayView {
  id         String   @id @default(cuid())
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String
  essayId    String // which essay in the package was opened
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([purchaseId])
  @@index([essayId])
}

// Short-lived 6-digit login codes (replaces the in-memory Map from the
// prototype so it survives across serverless invocations).
model LoginCode {
  email     String   @id
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
}
