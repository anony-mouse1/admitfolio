// Admitfolio database schema.
//
// Runs on Supabase Postgres. DATABASE_URL is the pooled (Supavisor, port 6543)
// connection string with ?pgbouncer=true&connection_limit=1 for serverless;
// DIRECT_URL is the direct (port 5432) string used by prisma migrate.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A verified seller — identity is a .edu email, proven via the OTP flow.
model Seller {
  id                         String                   @id @default(cuid())
  email                      String                   @unique
  passwordHash               String? // scrypt "salt:hash", set at signup
  failedLogins               Int                      @default(0) // consecutive bad passwords; reset on success
  lockedUntil                DateTime? // brute-force lockout expiry
  name                       String? // full name; display follows the listing's anonymity choice
  paypalEmail                String? // where biweekly payouts go once buying launches
  // Stripe Connect is deliberately created only after this seller's first
  // settled live sale. Until onboarding finishes, the 60% entitlement stays
  // attached to its Purchase row instead of being sent anywhere.
  stripeAccountId            String?                  @unique
  stripeOnboardingStartedAt  DateTime?
  stripeOnboardingCompleteAt DateTime?
  stripePayoutsEnabled       Boolean                  @default(false)
  stripeBankPayouts          SellerBankPayout[]
  bio                        String? // short "about me" shown on the seller profile
  photoPath                  String? // Supabase Storage path for the profile photo
  backgroundTags             String                   @default("[]") // JSON array of profile tags (e.g. First-generation)
  currentUniversity          String?
  currentMajor               String?
  graduationYear             String?
  createdAt                  DateTime                 @default(now())
  listings                   Listing[]
  admitProofs                AdmitProof[]
  applicationDrafts          SellerApplicationDraft[]
}

// An acceptance letter backing one school a seller claims in `Listing.admitTags`.
//
// Keyed on the SELLER, not the listing: a seller reuses the same admits across
// listings, and re-uploading the same letter each time would be busywork. The
// `schoolKey` is a normalised form (see lib/admitProof.ts) so "Tufts" and
// "Tufts University" are one proof rather than two.
//
// `pending` is the only status a seller can create. An admin can decide a proof
// directly while a listing is pending, but approving any listing verifies all
// admission claims for that seller. Approved legacy listings are also treated
// as verified when read even if they predate this table.
model AdmitProof {
  id                    String                 @id @default(cuid())
  seller                Seller                 @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId              String
  schoolKey             String // normalised; collapses spellings of the same school
  schoolLabel           String // what the seller actually typed, for display
  pdfPath               String? // Supabase Storage path, null until the upload lands
  status                String                 @default("pending") // pending | verified | rejected
  adminNote             String? // why it was rejected, shown to the seller
  createdAt             DateTime               @default(now())
  reviewedAt            DateTime?
  // What the review panel made of the letter. Advisory only: the panel never
  // sets `status`, exactly as it never publishes a listing. It puts a note
  // beside the Verify button so a human decides with the reading already done.
  aiCheckedAt           DateTime?
  aiGenuine             Boolean? // panel's read: does this look like a real admission decision
  aiNote                String? // one sentence - what it shows, or what is wrong with it
  version               Int                    @default(1) // increments whenever the seller replaces the file
  verificationRuns      VerificationRun[]
  verificationDecisions VerificationDecision[]

  @@unique([sellerId, schoolKey])
  @@index([status])
}

// One submission = one seller's package of essays for a school.
model Listing {
  id                String                   @id @default(cuid())
  seller            Seller                   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId          String
  school            String
  // The college this package was written for and should be filed under in the
  // catalogue. `school` above is the seller's current university, which is why
  // it is identical across that seller's listings and cannot be the card title.
  // Nullable only for listings created before this field existed.
  targetSchool      String?
  // Common App, UC Application, MIT Application, etc. Kept separately from the
  // target college because one application system can serve many colleges.
  applicationSystem String?
  gradYear          String? // seller's expected college graduation year, e.g. 2028
  major             String? // the seller's current major at their university
  appliedMajors     String? // major(s) they applied to with these essays, free text
  admitTags         String                   @default("[]") // JSON array of schools they got into
  // anonymous | revealOnPurchase | full. See lib/anonymity.ts: the middle value
  // is a TIMING choice (nothing public, first name once bought), not a "show
  // less of the name" choice. Rows written before 2026-08 spell it 'firstName'
  // and are read as the same thing.
  anonymity         String                   @default("anonymous")
  pricingMode       String                   @default("package") // package | separate
  packagePrice      Int? // whole dollars, when pricingMode = package
  teaser            String? // optional one-line hook shown on the public browse card
  // The opening sentence of the seller's own essay, read out of their uploaded
  // PDF. Only used when the seller left `teaser` empty, which is 68 of 144
  // approved listings, so those cards had nothing to say. Nullable forever:
  // short-answer listings have no narrative opening, and some PDFs are scans
  // with no text layer. Backfilled by scripts/extract-opening-lines.mjs.
  openingLine       String?
  status            String                   @default("pending") // pending | approved | rejected | removed (seller take-down)
  adminNote         String?
  sellerNote        String? // optional note from the seller, shown to the admin during review
  createdAt         DateTime                 @default(now())
  reviewedAt        DateTime?
  // Automated review (Claude reviewer panel). aiReviewedAt doubles as the
  // "already screened" guard for the cron query. Auto-approve flips `status`;
  // a flagged listing stays `pending` with these fields populated for the admin.
  aiReviewedAt      DateTime? // set once the panel has run
  // Atomic lease for an in-flight panel run. The final PDF upload and the cron
  // can race, so neither may call Claude unless it owns this lease. A stale
  // lease is retryable if a function is terminated before it can clear it.
  aiReviewStartedAt DateTime?
  aiDecision        String? // approved | flagged
  aiConfidence      String? // high | medium | low (lowest across the panel's lenses)
  aiReasons         String? // panel's concerns, shown to the admin on flagged listings
  aiSuggestion      String? // approve | reject — pre-fills the flagged listing's action
  aiLenses          String? // JSON array of per-lens verdicts, so the admin can read the full review
  // Set only when a human admin decides from the console - never by the cron.
  // This is what separates "the panel cleared it" from "I looked at it myself",
  // and drives the unaudited counts on the review tabs.
  humanReviewedAt   DateTime?
  // Admin shelf. Set from the console when a listing needs more thought than the
  // current pass allows. It carries no meaning to the seller and never changes
  // `status` - a shelved listing is exactly as published (or not) as before.
  savedAt           DateTime?
  essays            Essay[]
  purchases         Purchase[]
  sourceDraft       SellerApplicationDraft?  @relation("DraftFinalizedListing")
  revisionDrafts    SellerApplicationDraft[] @relation("DraftSourceListing")

  @@index([status])
  @@index([sellerId])
  @@index([targetSchool])
  @@index([aiReviewStartedAt])
}

// Private, resumable work owned by one authenticated seller. `state` contains
// only structured form values. Files are stored separately as DraftAsset rows
// so closing or refreshing the browser never discards an upload.
model SellerApplicationDraft {
  id                 String       @id @default(cuid())
  seller             Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId           String
  status             String       @default("draft") // draft | finalizing | submitted | abandoned
  step               Int          @default(1)
  state              Json         @default("{}")
  revision           Int          @default(1) // optimistic concurrency token
  finalizedListing   Listing?     @relation("DraftFinalizedListing", fields: [finalizedListingId], references: [id], onDelete: SetNull)
  finalizedListingId String?      @unique
  sourceListing      Listing?     @relation("DraftSourceListing", fields: [sourceListingId], references: [id], onDelete: SetNull)
  sourceListingId    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  submittedAt        DateTime?
  assets             DraftAsset[]

  @@index([sellerId, status, updatedAt])
  @@index([sourceListingId])
}

model DraftAsset {
  id          String                 @id @default(cuid())
  draft       SellerApplicationDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  draftId     String
  kind        String // essay | admitProof
  clientKey   String // stable browser row key, never a seller or listing id
  fileName    String
  mimeType    String
  sizeBytes   Int
  storagePath String                 @unique
  contentHash String?
  status      String                 @default("ready") // ready | replaced | finalized
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@unique([draftId, kind, clientKey])
  @@index([draftId, status])
  @@index([contentHash])
}

// Append-only AI and human verification history. The AdmitProof row keeps the
// current display state, while these rows preserve what was reviewed and why.
model VerificationRun {
  id             String                 @id @default(cuid())
  proof          AdmitProof             @relation(fields: [proofId], references: [id], onDelete: Cascade)
  proofId        String
  proofVersion   Int
  model          String
  rulesetVersion String
  result         Json
  confidence     String?
  createdAt      DateTime               @default(now())
  decisions      VerificationDecision[]

  @@index([proofId, proofVersion, createdAt])
}

model VerificationDecision {
  id           String           @id @default(cuid())
  proof        AdmitProof       @relation(fields: [proofId], references: [id], onDelete: Cascade)
  proofId      String
  proofVersion Int
  run          VerificationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  runId        String?
  actorType    String // ai | admin
  actorId      String? // admin email for human decisions; null for automated advice
  status       String // suggested_verified | suggested_rejected | verified | rejected
  note         String?
  createdAt    DateTime         @default(now())

  @@index([proofId, proofVersion, createdAt])
}

// An individual essay within a listing.
model Essay {
  id          String   @id @default(cuid())
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId   String
  prompt      String // e.g. "Common App", "Why Yale"
  question    String? // custom prompt text when prompt = "Other"
  price       Int? // whole dollars, when the listing sells essays separately
  wordCount   Int?
  pdfPath     String? // Supabase Storage object path, e.g. listings/<listingId>/<essayId>.pdf
  // SHA-256 of the uploaded PDF. Used to stop one seller from putting the exact
  // same file into multiple active listings and charging a buyer twice for it.
  contentHash String?
  sortOrder   Int      @default(0) // position in the seller's submitted list
  createdAt   DateTime @default(now())

  @@index([listingId])
  @@index([contentHash])
}

// Email captured from the "notify me at launch" forms.
model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A paid buyer checkout. The purchase unit is a Listing, never an individual
// Essay. `essayId` remains only for historical rows from the prototype.
model Purchase {
  id                              String      @id @default(cuid())
  buyerEmail                      String
  listing                         Listing?    @relation(fields: [listingId], references: [id])
  listingId                       String?
  essayId                         String? // legacy only; all new purchases buy the listing
  itemLabel                       String? // checkout snapshot, e.g. "Stanford · 4 essays"
  amount                          Int // legacy whole-dollar amount, retained for older readers
  grossAmountCents                Int? // exact Stripe amount for all new purchases
  sellerEarningsCents             Int? // immutable final seller transfer after all snapshotted fees
  platformFeeCents                Int? // immutable Admitfolio share, currently 40% of gross
  stripeProcessingFeeCents        Int? // immutable actual Stripe fee; null on legacy purchases
  sellerShareBps                  Int? // split snapshot; 6000 means 60%
  checkoutVersion                 String? // v3 waits for Stripe's actual fee before finalizing seller earnings
  currency                        String? // lowercase ISO currency, currently usd
  stripeSessionId                 String?     @unique // idempotency key for Stripe webhook retries
  stripePaymentIntentId           String?     @unique // reconciliation/refund reference
  stripeChargeId                  String?     @unique // source charge for the seller's separate Connect transfer
  stripeTransferId                String?     @unique // one Connect transfer per purchase
  sellerTransferStartedAt         DateTime? // retry lease; Stripe idempotency is the final duplicate guard
  sellerTransferredAt             DateTime?
  sellerTransferAttempts          Int         @default(0)
  sellerTransferLastError         String?
  sellerTransferReversedCents     Int         @default(0)
  sellerTransferLastReversalId    String?
  sellerTransferReversedAt        DateTime?
  sellerTransferReversalStartedAt DateTime?
  sellerTransferReversalLastError String?
  sellerNotifiedAt                DateTime? // prevents routine webhook retries from re-emailing the seller
  // Buyer's IP at checkout. Captured in /api/checkout (which the buyer's
  // browser calls) and carried through Stripe session metadata - reading
  // x-forwarded-for in the webhook would record Stripe's servers instead.
  buyerIp                         String?
  // Non-reversible code printed into this buyer's copy. It maps a leaked copy
  // back to this server-side purchase without exposing the buyer's email or IP
  // in the document itself.
  deliveryFingerprint             String?     @unique
  // Email delivery has a short lease so concurrent Stripe retries send only
  // once, while a crashed attempt becomes retryable after ten minutes.
  deliveryStartedAt               DateTime?
  deliveryEmailSentAt             DateTime?
  deliveryAttempts                Int         @default(0)
  deliveryLastError               String?
  createdAt                       DateTime    @default(now())
  views                           EssayView[]

  @@index([listingId])
  @@index([sellerNotifiedAt])
  @@index([sellerTransferredAt])
}

// One cart-recovery reminder per opted-in buyer. Email is unique on purpose:
// repeated Checkout Sessions must never turn into repeated marketing emails.
// A short send lease makes webhook retries safe without permanently stranding
// a failed provider request.
model CheckoutRecoveryEmail {
  id                String    @id @default(cuid())
  email             String    @unique
  stripeSessionId   String    @unique
  listingId         String
  itemLabel         String
  amountCents       Int
  sessionCreatedAt  DateTime
  recoveryExpiresAt DateTime
  sendStartedAt     DateTime?
  sentAt            DateTime?
  sendAttempts      Int       @default(0)
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([sentAt])
}

// A Stripe payout from a seller's connected balance to their bank account.
// Transfers into Stripe and payouts to a bank are separate money movements,
// so this record lets the dashboard distinguish "sent to Stripe" from
// "deposited in your bank" without storing any bank details.
model SellerBankPayout {
  id                   String    @id // Stripe payout id (po_...)
  seller               Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId             String
  stripeAccountId      String
  amountCents          Int
  currency             String
  status               String // pending | in_transit | paid | failed | canceled
  automatic            Boolean
  arrivalDate          DateTime?
  failureCode          String?
  stripeCreatedAt      DateTime
  stripeEventCreatedAt DateTime
  stripeEventId        String
  paidAt               DateTime?
  failedAt             DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([sellerId, status])
  @@index([stripeAccountId])
  @@index([stripeCreatedAt])
}

// One row per essay read. Buyers have no account, so a view is attributed via
// the purchase (which carries Stripe's verified buyerEmail) rather than a user
// id. This is what makes a leaked watermark traceable to a person.
model EssayView {
  id         String   @id @default(cuid())
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String
  essayId    String // which essay in the package was opened
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([purchaseId])
  @@index([essayId])
}

// Short-lived 6-digit login codes (replaces the in-memory Map from the
// prototype so it survives across serverless invocations).
model LoginCode {
  email     String   @id
  code      String
  purpose   String   @default("signup") // signup | reset; prevents cross-flow token use
  expiresAt DateTime
  attempts  Int      @default(0)
}

// One signed OTP result can authorize exactly one signup or password reset.
// Keeping the nonce server-side prevents a captured one-hour email token from
// being replayed after the action already succeeded.
model EmailActionToken {
  id         String    @id
  email      String
  purpose    String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose, consumedAt])
  @@index([expiresAt])
}
